NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentsync?schema=public
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=0
COOKIE_SAME_SITE=lax
# Gmail app password for password recovery email.
EMAIL_USER=
EMAIL_PASS=
# Required for PDF resume uploads. Enable PDF/raw delivery in Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional dedicated test database with CREATE SCHEMA permission.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentsync_tests?schema=public
